# Local PostgreSQL Development Configuration (Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=localdevpass

# Optional PGAdmin Credentials
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=<PGADMIN_PASSWORD>
PGADMIN_PORT=8080

# C++ Telemetry Agent (Docker Compose)
TELEMETRY_API_URL=http://host.docker.internal:3000/IngestMetrics
