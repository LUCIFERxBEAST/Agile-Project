# Database Credentials (For AWS Lambda & Local Testing)
DB_HOST=your-rds-instance-endpoint.c123456789.us-east-1.rds.amazonaws.com
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=<DB_PASSWORD>
DB_PORT=5432

# AWS API Gateway Endpoints (Generated after 'sam deploy' or manual API Gateway creation)
AWS_INGEST_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/IngestMetrics
AWS_GET_METRICS_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/GetMetrics
